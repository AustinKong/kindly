---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import SyntaxExamples from '../components/SyntaxExamples.astro';
import Button from '../components/shared/Button.astro';
---

<Layout>
  <main>
    <header>
      <img src="/images/hero.png" alt="" width="2172" height="724" />
      <h1><img src="/icon.svg" alt="" width="101" height="101" />Kindly</h1>
    </header>
    <section aria-labelledby="introduction">
      <h2 id="introduction">Code has become far too informal.</h2>
      <div>
        <p>
          For decades, developers have issued commands without so much as a please or thank you.
        </p>
        <p>
          Variables are assigned without consent. Functions are called without prior notice.
          Programs terminate without a proper farewell.
        </p>
        <p>We believe it's time for a change.</p>
        <div>
          <Button href="/editor" variant="primary"
            >Try editor <ArrowUpRight aria-hidden="true" /></Button
          >
          <Button href="/docs">Documentation <ArrowRight aria-hidden="true" /></Button>
        </div>
      </div>
    </section>
    <section aria-labelledby="examples">
      <div>
        <h2 id="examples">A more professional way to program.</h2>
        <p>The same ideas, with a little more courtesy.</p>
      </div>
      <SyntaxExamples />
    </section>
    <footer>
      <a href="/" aria-label="Kindly home">Kindly</a>
      <a href="/editor">Write your first few lines <ArrowUpRight size={16} aria-hidden="true" /></a>
    </footer>
  </main>
</Layout>

<style>
  main {
    max-width: none;
    padding: 0;
    background: #fff;
  }
  main > header {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    height: clamp(15rem, 35vw, 34rem);
  }
  main > header > img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  main > header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(12 20 46 / 18%);
  }
  h1 {
    display: flex;
    align-items: center;
    gap: 0.2em;
    margin: 0;
    color: #fff;
    font-size: clamp(4rem, 6vw, 9rem);
    line-height: 1;
    text-shadow: 0 2px 24px rgb(12 20 46 / 20%);
  }
  h1 img {
    width: 0.95em;
    height: 0.95em;
    flex-shrink: 0;
  }
  main > section,
  footer {
    width: min(100% - 6rem, 80rem);
    margin-inline: auto;
  }
  section {
    display: grid;
    padding-block: 5rem;
    border-top: 1px solid var(--color-border);
  }
  section:first-of-type {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    align-items: start;
    gap: 3rem;
    padding-block: 3.5rem 4.5rem;
    border-top: 0;
  }
  section:first-of-type h2 {
    max-width: none;
    margin: 0;
    font-size: clamp(2.6rem, 4.6vw, 4.75rem);
    line-height: 1.05;
  }
  h2 {
    max-width: 23rem;
  }
  section p {
    max-width: 26rem;
    margin: 0;
  }
  section:first-of-type p {
    max-width: 40rem;
  }
  section:first-of-type p + p {
    margin-top: 1.25rem;
  }
  section:first-of-type > div > div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--color-border);
    padding-block: 2rem;
    font-size: 0.8rem;
  }
  footer a {
    color: var(--color-muted);
    text-decoration: none;
  }
  section[aria-labelledby='examples'] {
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.8fr);
    align-items: start;
    gap: 3rem;
  }
  @media (max-width: 1050px) {
    section[aria-labelledby='examples'] {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 700px) {
    main > section,
    footer {
      width: calc(100% - 2.5rem);
    }
    section,
    section:first-of-type {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-block: 2.5rem;
    }
    section:first-of-type h2 {
      font-size: clamp(2rem, 10vw, 2.8rem);
    }
    section p {
      max-width: none;
    }
  }
</style>
