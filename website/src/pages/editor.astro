---
import Layout from '../layouts/Layout.astro';
import Playground from '../components/playground/Playground';
---

<Layout title="Editor · Kindly">
  <main>
    <Playground client:load />
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: none;
    min-height: 100svh;
    padding: 1.5rem;
  }
  main :global(.page-nav) {
    margin: 0;
  }
  @media (max-width: 48rem) {
    main {
      padding: 1rem;
    }
  }
</style>
