---
import { Code } from 'astro:components';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { simpleGrammar } from '../../languages/simple/grammar';

const sections = [
  {
    id: 'collections',
    title: 'Collections',
    functions: [
      [
        'len(collection)',
        'Returns the number of elements in a list or deque, entries in a dictionary, or Unicode characters in a string.',
      ],
      [
        'contains(collection, value)',
        'Returns True if a list or deque contains the value, or a dictionary contains the key; otherwise False.',
      ],
      [
        'copy(collection)',
        'Returns a shallow copy of a list, deque, or dictionary. The outer container is independent; nested values remain shared.',
      ],
      ['append(collection, value)', 'Adds a value to the back of a list or deque. Returns None.'],
      [
        'extend(destination, source)',
        'Appends all source elements to destination. Both arguments may be lists or deques, including the same container. Returns None.',
      ],
      [
        'pop(collection)',
        'Removes and returns the last element of a list or deque. An empty container raises an error.',
      ],
    ],
    example: `var items = [1, 2]
append(items, 3)
extend(items, [4, 5])
var snapshot = copy(items)
print(len(snapshot))   # 5
print(contains(items, 3))
print(pop(items))      # 5`,
  },
  {
    id: 'lists',
    title: 'Lists',
    functions: [
      [
        'insert(list, index, value)',
        'Inserts before an integer index. Negative indices count from the end; positions outside the list clamp to either end. Returns None.',
      ],
      [
        'index(list, value)',
        'Returns the zero-based index of the first matching value. Raises an error if the value is absent.',
      ],
      [
        'remove(list, value)',
        'Removes the first matching value. Returns None; raises an error if the value is absent.',
      ],
      ['reverse(list)', 'Reverses the list in place. Returns None.'],
      [
        'sort(list)',
        'Sorts the list in ascending order, in place. Accepts numbers, including mixed integers and floats, or strings. Incompatible values raise an error before mutation. Returns None.',
      ],
    ],
    example: `var items = [3, 1, 2]
insert(items, 0, 4)
print(index(items, 4))  # 0
remove(items, 4)
sort(items)
print(items)           # [1, 2, 3]
reverse(items)
print(items)           # [3, 2, 1]`,
  },
  {
    id: 'slicing',
    title: 'Slicing',
    description:
      'Bounds must be integers or None. The start is inclusive and the stop is exclusive. Negative bounds count from the end; bounds outside the sequence are clamped. An omitted or None bound selects the beginning or end. If stop is at or before start, the result is empty.',
    functions: [
      [
        'slice(value, start = None, stop = None)',
        'Returns a new list or string containing the selected range. List slices are shallow copies.',
      ],
    ],
    example: `print(slice([10, 20, 30, 40], 1, 3))  # [20, 30]
print(slice("hello", -2))             # lo
print(slice("hello", None, 2))        # he`,
  },
  {
    id: 'dictionaries',
    title: 'Dictionaries',
    description:
      'Keys may be strings, numbers, booleans, or None. A key whose value is None is still present. Fallback expressions are evaluated before the call, even when the key exists.',
    functions: [
      [
        'get(dictionary, key, fallback = None)',
        'Returns the value for key, or fallback if absent. Does not insert a missing key.',
      ],
      [
        'pop(dictionary, key, fallback = None)',
        'Removes and returns the value for key. If absent, returns fallback without changing the dictionary.',
      ],
      [
        'remove(dictionary, key)',
        'Removes the key and its value. Returns None; raises an error if the key is absent.',
      ],
      [
        'keys(dictionary)',
        'Returns a new list of keys in insertion order. Later dictionary changes do not alter this list.',
      ],
      [
        'values(dictionary)',
        'Returns a new list of values in insertion order. The list is a snapshot; nested values remain shared.',
      ],
    ],
    example: `var settings = {"theme": "blue", "size": 4}
print(get(settings, "theme"))          # blue
print(get(settings, "missing", 0))     # 0
print(keys(settings))
print(values(settings))
print(pop(settings, "size"))           # 4
remove(settings, "theme")`,
  },
  {
    id: 'deques',
    title: 'Deques',
    description:
      'A deque supports insertion and removal at both ends. Use append and pop for the back, and append_front and pop_front for the front. The collection functions above also accept deques.',
    functions: [
      [
        'deque(items = [])',
        'Creates an empty deque, or a deque containing the values of a list in order. Nested values remain shared.',
      ],
      ['append_front(deque, value)', 'Adds a value at the front. Returns None.'],
      ['pop_front(deque)', 'Removes and returns the first value. An empty deque raises an error.'],
    ],
    example: `var queue = deque(["second"])
append_front(queue, "first")
append(queue, "third")
print(pop_front(queue))  # first
print(pop(queue))        # third`,
  },
  {
    id: 'output',
    title: 'Output',
    functions: [
      [
        'print(value)',
        'Writes one formatted value to the output and returns None. Formats nested containers and handles circular references.',
      ],
    ],
    example: `print("Hello, world!")
print([1, 2, 3])`,
  },
];
---

<DocsLayout
  title="Standard library · Kindly"
  description="Standard library reference with Simple syntax examples."
  active="standard-library"
>
  <h1>Standard library</h1>
  <p>
    These functions are available globally in both Simple and Kindly. Examples use Simple syntax.
  </p>
  <p>
    Arguments are positional. Signatures show defaults for optional arguments. Invalid argument
    types or counts raise runtime errors.
  </p>
  <nav aria-label="Standard library sections">
    {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
  </nav>
  {
    sections.map((section) => (
      <section aria-labelledby={section.id}>
        <h2 id={section.id}>{section.title}</h2>
        {section.description && <p>{section.description}</p>}
        <div>
          <table>
            <thead>
              <tr>
                <>
                  <th scope="col">Function</th>
                  <th scope="col">Behavior</th>
                </>
              </tr>
            </thead>
            <tbody>
              {section.functions.map(([signature, description]) => (
                <tr>
                  <th scope="row">
                    <code>{signature}</code>
                  </th>
                  <td>{description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <Code code={section.example} lang={simpleGrammar} theme="github-light" />
      </section>
    ))
  }
</DocsLayout>
