{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Godot: Import",
      "type": "shell",
      "command": "godot",
      "args": [
        "--headless",
        "--editor",
        "--path",
        "${workspaceFolder}/runtime",
        "--import",
        "--quit"
      ],
      "problemMatcher": []
    },
    {
      "label": "Godot: Editor",
      "type": "shell",
      "command": "godot",
      "args": [
        "--editor",
        "--path",
        "${workspaceFolder}/runtime"
      ],
      "problemMatcher": []
    },
    {
      "label": "Godot: Tests",
      "type": "shell",
      "command": "godot",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}/runtime",
        "--script",
        "res://addons/gdUnit4/bin/GdUnitCmdTool.gd",
        "--ignoreHeadlessMode",
        "-a",
        "res://tests/unit",
        "-rd",
        "res://.godot/gdunit-reports"
      ],
      "problemMatcher": []
    }
  ]
}
