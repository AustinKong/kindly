{
  "files.exclude": {
    "addons": true,
    "**/.git": true,
    "**/.vscode": true,
    "**/.editorconfig": true,
    "**/.gitattributes": true,
    "**/.gitignore": true,
    "**/.godot": true,
    "**/*.uid": true,
    "**/*.import": true
  },
  "search.exclude": {
    "**/.godot": true,
    "**/*.uid": true,
    "**/*.import": true
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[gdscript]": {
    "editor.defaultFormatter": "geequlim.godot-tools",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  }
}
