{
  "files.exclude": {
    "runtime/addons": true,
    "**/.git": true,
    "**/.vscode": true,
    "**/.editorconfig": true,
    "**/.gitattributes": true,
    "**/.gitignore": true,
    "**/.godot": true,
    "**/*.uid": true,
    "**/*.import": true,
    "**/node_modules": true,
    "website/.astro": true,
    "website/dist": true,
    "website/package-lock.json": true,
    "website/astro.config.mjs": true,
    "website/tsconfig.json": true,
    "website/.prettierrc": true,
    "website/.prettierignore": true,
    "website/public/runtime": true,
    "runtime/build": true
  },
  "search.exclude": {
    "**/.godot": true,
    "**/*.uid": true,
    "**/*.import": true,
    "**/node_modules": true,
    "website/.astro": true,
    "website/dist": true,
    "website/public/runtime": true,
    "runtime/build": true
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "[gdscript]": {
    "editor.defaultFormatter": "geequlim.godot-tools",
    "editor.formatOnSave": true,
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "prettier.prettierPath": "website/node_modules/prettier",
  "prettier.requireConfig": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
    "editor.formatOnSave": true
  }
}
